cat > model.sdf << 'EOF'
<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="first_aid_kit">
    <static>true</static>

    <link name="link">
      <pose>0 0 0.15 0 0 0</pose>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://first_aid_kit/model.glb</uri>
            <scale>0.4 0.4 0.4</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.5 0.15 0.35</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
EOF